# Креды репозитория команды the team.
#
# Список ИМЁН переменных, а не значений: этот файл трекается, а значения живут
# в gitignore-нутом .env рядом, который создаётся из этого шаблона и
# заполняется руками. Агент .env не
# читает и значения не печатает — см. `env-check` skill.

# === GitHub ===
# Единственный Git credential — GITHUB_TOKEN из окружения процесса или этого
# корневого .env. Заданное окружение процесса имеет приоритет (даже если пусто).
# Все Git-операции используют HTTPS; gh получает тот же токен через общую
# библиотеку commit-and-mr. GH_TOKEN, keyring и SSH не используются.
# GITHUB_TOKEN=your_github_personal_access_token

# === Notion (опционально, для скиллов notion / notion-publish / notion-snapshot) ===
# Секрет внутренней интеграции с https://www.notion.so/profile/integrations —
# интеграцию нужно ещё подключить к каждой странице, куда публикуете.
# Корни задаёт notion.json в корне репозитория.
# NOTION_TOKEN=ntn_your_notion_integration_secret
# Email коммитера слепка Notion в свежем клоне notion-snapshot (у клона нет
# git identity). По умолчанию: notion-snapshot@localhost.
# NOTION_SNAPSHOT_GIT_EMAIL=you@example.com

# === Asana (опционально, для скилла asana) ===
# Personal access token с https://app.asana.com/0/my-apps.
# ASANA_TOKEN=your_asana_personal_access_token
# Воркспейс и проект/доска по умолчанию для скилла Asana.
# ASANA_WORKSPACE_GID=1200000000000000
# ASANA_PROJECT_GID=1200000000000001
# Опциональные кастомные поля для связи задач Asana с change'ами OpenSpec.
# ASANA_SPEC_FIELD_GID=1200000000000002
# ASANA_TASK_FIELD_GID=1200000000000003
# ASANA_DEFAULT_ASSIGNEE_GID=1200000000000004
# Опциональные официальные креды Asana cloud MCP V2 для Codex/mcp-remote.
# OAuth-клиент MCP заводится в developer console Asana.
# ASANA_CLIENT_ID=your_asana_mcp_oauth_client_id
# ASANA_CLIENT_SECRET=your_asana_mcp_oauth_client_secret

# === Slack MCP (опционально, для скилла slack) ===
# slack-mcp-server принимает user token или bot token.
# User token предпочтительнее — даёт поиск в user-контексте и историю каналов.
# Эти два имени — единственные, которые он читает: xoxb-токен под именем
# SLACK_BOT_TOKEN никуда не дойдёт.
# SLACK_MCP_XOXP_TOKEN=xoxp-your_slack_user_token
# SLACK_MCP_XOXB_TOKEN=xoxb-your_slack_bot_token

# === Grafana MCP (опционально, для скиллов service-logs / project-metrics / grafana-dashboard-*) ===
# Base64-payload для заголовка Authorization: Basic. Без буквального префикса
# "Basic " — его добавляет обёртка MCP-сервера при старте mcp-remote.
# GRAFANA_MCP_BASIC_AUTH=base64_user_colon_password_for_dev_grafana
# GRAFANA_PROD_MCP_BASIC_AUTH=base64_user_colon_password_for_prod_grafana

# === Kubernetes (опционально, для скиллов kube-read / kube-service-health) ===
# Креды Kubernetes — файлы, а не значения .env. Кладутся в корень воркспейса,
# рядом с .env; корневой .gitignore их исключает:
#   kube_config_dev
#   kube_config_prod
# У каждого файла — read-only RBAC-идентичность и права 0600. Содержимое
# kubeconfig никогда не вставляется в .env, сообщение, трекаемый файл или
# аргумент командной строки.

# === PostgreSQL (optional, db-query) ===
# Set only databases and environments needed by your team.
# DB_URI_APP_DEV=postgresql://user:password@host:5432/app
# DB_URI_APP_PROD=postgresql://user:password@host:5432/app?sslmode=require
