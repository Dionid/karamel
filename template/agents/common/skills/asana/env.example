# Asana personal access token — https://app.asana.com/0/my-apps
ASANA_TOKEN=
# workspace ("organization") gid — GET /users/me или URL доски
ASANA_WORKSPACE_GID=
# project (доска) gid — из URL доски: .../0/<project_gid>/...
ASANA_PROJECT_GID=
# (опционально) gid кастомного поля для ссылки на спеку/MR
ASANA_SPEC_FIELD_GID=
# (опционально) gid пользователя для автоназначения новых задач
ASANA_DEFAULT_ASSIGNEE_GID=
