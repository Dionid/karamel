# slack-mcp-server reads only these two names — SLACK_BOT_TOKEN is NOT one of
# them. At least one must be set; a user token (xoxp) is required to build the
# channels cache (see refresh-cache.sh) — a bot token only sees channels it was
# invited to. Neither name alone is unconditionally required, so both are
# marked (опционально) here — the real requirement ("at least one") is not a
# per-variable one and is documented in SKILL.md, not encoded as a flat
# required/optional marker.
# (опционально) user token (xoxp-...) — needed to build the channels cache
SLACK_MCP_XOXP_TOKEN=
# (опционально) bot token (xoxb-...) — sees only channels the bot was invited to
SLACK_MCP_XOXB_TOKEN=

# (опционально) where the users/channels caches live. Default is $HOME/.cache/
# — fine on a developer machine, but wrong on a hosting runtime whose $HOME is
# scoped to one session. Point this at a directory that survives the session.
WORKSPACE_CACHE_DIR=

# (опционально) enable the reactions_add/reactions_remove MCP tool. Off by
# default — a team turns it on for itself, it is never forced on.
SLACK_MCP_REACTION_TOOL=
# (опционально) enable the conversations_add_message (post/reply) MCP tool.
# Off by default, for the same reason.
SLACK_MCP_ADD_MESSAGE_TOOL=
# (опционально) pin a different slack-mcp-server version than the default
# (1.3.0) mcp-server.sh ships with — only after checking the new version's
# cache shape against refresh_cache.py's `convert`.
SLACK_MCP_SERVER_VERSION=
