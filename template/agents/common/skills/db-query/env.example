# db-query читает строки подключения по конвенции DB_URI_<БАЗА>_<ОКРУЖЕНИЕ>,
# где <БАЗА> — имя из --db (верхним регистром), <ОКРУЖЕНИЕ> — DEV или PROD.
#
# Этот файл не перечисляет реальные базы команды — их заводит "db"-карточка
# кастомизации при подключении этого скилла. Пример формы, которую принимает
# каждая запись:
#
# DB_URI_<БАЗА>_DEV=postgresql://user:pass@host:5432/dbname
# DB_URI_<БАЗА>_PROD=postgresql://user:pass@host:5432/dbname
