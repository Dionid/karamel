{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(/packages/**)",
      "Read(**/node_modules/**)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/*.p12)",
      "Read(**/*.p8)",
      "Read(**/*.cer)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force *)",
      "Bash(git push * -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(*wt rm *--force*)",
      "Bash(*skills/wt/wt rm *--force*)"
    ]
  },
  "env": {
    "SLASH_COMMAND_TOOL_CHAR_BUDGET": "20000"
  },
  "fileSuggestion": {
    "type": "command",
    "command": "$CLAUDE_PROJECT_DIR/.claude/file-suggestion.sh"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/skills/coordination/coord\" hook --client claude",
            "timeout": 5,
            "statusMessage": "Координация: старт — регистрирует сессию и показывает активные задачи"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/skills/coordination/coord\" hook --client claude",
            "timeout": 5,
            "statusMessage": "Координация: запрос — обновляет lease перед новым сообщением"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/skills/coordination/coord\" hook --client claude",
            "timeout": 5,
            "statusMessage": "Координация: до инструмента — отмечает занятость и ищет пересечения"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-secret-reads.sh\"",
            "timeout": 10,
            "statusMessage": "Защита секретов — блокирует чтение .env и вывод secret-переменных"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-workspace-deletion.sh\"",
            "timeout": 10,
            "statusMessage": "Защита воркспейса — блокирует удаление корня и общего каталога"
          }
        ]
      },
      {
        "matcher": "CronCreate|CronList|CronDelete|ScheduleWakeup|RemoteTrigger|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-claude-crons.sh\"",
            "timeout": 10,
            "statusMessage": "Расписания — блокирует планировщики Claude Code в пользу Cron Job рантайма"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-agent-routing.py\"",
            "timeout": 10,
            "statusMessage": "Маршрутизация — запрещает root запись, live-операции и долгое исследование без child"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/skills/coordination/coord\" hook --client claude",
            "timeout": 5,
            "statusMessage": "Координация: после инструмента — обновляет lease и рабочее состояние"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/skills/coordination/coord\" hook --client claude",
            "timeout": 5,
            "statusMessage": "Координация: остановка — отмечает ожидание следующего запроса"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/skills/coordination/coord\" hook --client claude",
            "timeout": 5,
            "statusMessage": "Координация: завершение — закрывает lease сессии"
          }
        ]
      }
    ]
  }
}
