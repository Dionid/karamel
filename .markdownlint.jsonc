// Правила markdownlint для доков и спек Engineering agent. Их читают markdownlint-cli2 (CI
// и локальный запуск) и расширение VSCode, так что редактор и пайплайн
// согласны, а не редактор ворчит на правила, которые никто не проверяет. Что
// именно линтится — в .markdownlint-cli2.jsonc.
//
// Набор сохраняет исходную планку агентского харнесса —
// «собьёт ли это агента, читающего файл», а не чей-то чужой house style. Каждое
// отключённое правило отключено по причине, записанной рядом.
{
  "default": true,

  // Проза переносится руками около 80, но таблицы, длинные ссылки GitHub и
  // `description:` во frontmatter (одна строка по формату) законно длиннее.
  // Правило означало бы постоянное переформатирование ради того, чего агент
  // не видит.
  "MD013": false,

  // `<task>`, `<repo>`, `<change>` — словарь плейсхолдеров этих доков, они
  // встречаются в обычной прозе. MD033 принимает их за inline HTML.
  "MD033": false,

  // Файлы открываются YAML-frontmatter'ом или, как CLAUDE.md, голым
  // `@AGENTS.md`. Ни то ни другое не заголовок и не должно им быть.
  "MD041": false,

  // `**Затронутые репозитории**` и `**Вне рамок**` — подписи внутри
  // `## Proposal` спек и proposal'ов, а не разделы. Настоящий `###` на их месте
  // встал бы в ту же иерархию, что `### Requirement:`, которую разбирает
  // OpenSpec, — ради правила оформления менять структуру спеки не стоит.
  "MD036": false,

  // Выгрузки из Notion несут и `title:` во frontmatter, и тот же `# Заголовок`
  // в теле. Второй H1 — это ровно тот, что в теле; frontmatter им не считаем.
  "MD025": { "front_matter_title": "" },

  // Одинаковые заголовки в разных разделах нормальны («#### Scenario:» в
  // каждом Requirement спеки); запрещены только соседние.
  "MD024": { "siblings_only": true },

  // Fence без языка — ровно то, из-за чего неверно помеченный блок остаётся
  // невидимым. Для шаблонов промптов и деревьев каталогов тег — `text`.
  "MD040": true,

  // Таблицы с отступами — то, что уже преобладает и остаётся читаемым в diff.
  "MD060": { "style": "padded" },

  // Звёздочки для курсива и жирного — как уже принято.
  "MD049": { "style": "asterisk" },
  "MD050": { "style": "asterisk" },

  // Нумерованные списки нумеруются 1..N для читателя; проза ссылается на
  // «шаг 5», и перенумерация правилом с ней бы спорила.
  "MD029": { "style": "ordered" }
}
